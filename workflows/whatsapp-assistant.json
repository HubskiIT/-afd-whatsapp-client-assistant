    {
      "parameters": {
        "jsCode": "// Godziny pracy salonu: pn-pt 9:00-19:00, sobota 9:00-14:00 (Europe/Warsaw).\n// Proponujemy 3 najblizsze wolne sloty po 60 minut, z min. 2h wyprzedzeniem.\nconst TZ = 'Europe/Warsaw';\nconst OPEN_HOURS = { 1: [9, 19], 2: [9, 19], 3: [9, 19], 4: [9, 19], 5: [9, 19], 6: [9, 14], 7: null };\nconst DAY_NAMES = { 1: 'pon', 2: 'wt', 3: 'sr', 4: 'czw', 5: 'pt', 6: 'sob', 7: 'niedz' };\n\nconst src = $('Parse Message').first().json;\n\n// zajete przedzialy z odpowiedzi freeBusy (format raw) lub listy slotow\nconst busy = [];\nfor (const item of $input.all()) {\n  const cals = item.json.calendars;\n  if (cals) {\n    for (const key of Object.keys(cals)) {\n      for (const b of cals[key].busy || []) busy.push({ start: new Date(b.start), end: new Date(b.end) });\n    }\n  } else if (item.json.start && item.json.end) {\n    busy.push({ start: new Date(item.json.start), end: new Date(item.json.end) });\n  }\n}\n\nconst fmt = new Intl.DateTimeFormat('en-GB', { timeZone: TZ, weekday: 'short', hour: 'numeric', minute: 'numeric', hour12: false });\nconst weekdayMap = { Mon: 1, Tue: 2, Wed: 3, Thu: 4, Fri: 5, Sat: 6, Sun: 7 };\nfunction warsawParts(date) {\n  const parts = {};\n  for (const p of fmt.formatToParts(date)) parts[p.type] = p.value;\n  return { weekday: weekdayMap[parts.weekday], hour: Number(parts.hour) % 24 };\n}\nconst dateFmt = new Intl.DateTimeFormat('pl-PL', { timeZone: TZ, day: '2-digit', month: '2-digit' });\nconst overlaps = (start, end) => busy.some((b) => start < b.end && b.start < end);\n\n// hak testowy: testy e2e wstrzykuja staly czas przez __testNow\nconst now = $json.__testNow ? new Date($json.__testNow) : new Date();\nconst HOUR = 3600000;\nconst firstSlot = Math.ceil((now.getTime() + 2 * HOUR) / HOUR) * HOUR;\n\nconst slots = [];\nfor (let ts = firstSlot; ts < now.getTime() + 7 * 24 * HOUR && slots.length < 3; ts += HOUR) {\n  const start = new Date(ts);\n  const { weekday, hour } = warsawParts(start);\n  const hours = OPEN_HOURS[weekday];\n  if (!hours) continue;\n  if (hour < hours[0] || hour + 1 > hours[1]) continue;\n  const end = new Date(ts + HOUR);\n  if (overlaps(start, end)) continue;\n  slots.push({ start, weekday, hour });\n}\n\nlet reply;\nif (slots.length === 0) {\n  reply = 'W najblizszych dniach nie mamy wolnych terminow. Przekazalam Twoja prosbe do recepcji - odezwiemy sie, zeby znalezc dogodny termin.';\n} else {\n  const lines = slots.map((s) => '- ' + DAY_NAMES[s.weekday] + ' ' + dateFmt.format(s.start) + ' o ' + String(s.hour).padStart(2, '0') + ':00');\n  reply = 'Najblizsze wolne terminy:\\n' + lines.join('\\n') + '\\nOdpisz, ktory pasuje, a potwierdzimy wizyte.';\n}\n\nreturn [{ json: { from: src.from, text: src.text, name: src.name, intent: 'rezerwacja', reply, handled_by: 'bot' } }];"
      },
