    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Buduje request do OpenAI: klasyfikacja intencji na 4 kategorie.\nconst system = [\n  'Jestes klasyfikatorem wiadomosci przychodzacych do salonu kosmetycznego.',\n  'Przypisz wiadomosc klienta do dokladnie jednej kategorii:',\n  '- \"faq\": pytanie o cennik, godziny otwarcia, adres, platnosci, przebieg zabiegow',\n  '- \"rezerwacja\": chec umowienia, przelozenia lub odwolania wizyty',\n  '- \"eskalacja\": reklamacja, sprawa pilna, niezadowolony klient, prosba o rozmowe z czlowiekiem',\n  '- \"inne\": nic z powyzszych',\n  'Odpowiedz wylacznie obiektem JSON: {\"intent\": \"<kategoria>\", \"confidence\": <0.0-1.0>}.',\n  'Jesli nie masz pewnosci, obniz confidence - lepiej eskalowac niz zgadywac.',\n].join('\\n');\n\nreturn { json: {\n  body: {\n    model: 'gpt-4o-mini',\n    temperature: 0,\n    response_format: { type: 'json_object' },\n    messages: [\n      { role: 'system', content: system },\n      { role: 'user', content: $json.text },\n    ],\n  },\n} };"
      },
