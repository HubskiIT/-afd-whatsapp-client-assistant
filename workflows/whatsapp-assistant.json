        "mode": "runOnceForEachItem",
        "jsCode": "// Parsuje odpowiedz FAQ; brak dopasowania kieruje do galezi eskalacji.\nconst src = $('Parse Message').first().json;\nlet found = false;\nlet reply = '';\ntry {\n  const parsed = JSON.parse($json.choices[0].message.content);\n  reply = (parsed.reply || '').trim();\n  found = parsed.found === true && reply !== '';\n} catch (e) {\n  // niepoprawny JSON -> found zostaje false -> eskalacja\n}\nreturn { json: { from: src.from, text: src.text, name: src.name, intent: 'faq', found, reply, handled_by: 'bot' } };"
