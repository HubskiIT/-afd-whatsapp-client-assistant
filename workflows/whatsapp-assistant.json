    {
      "parameters": {
        "jsCode": "// Sklada baze FAQ z arkusza w prompt i buduje request do OpenAI.\nconst rows = $input.all().map((i) => i.json).filter((r) => r.question && r.answer);\nconst faq = rows.map((r) => 'P: ' + r.question + '\\nO: ' + r.answer).join('\\n\\n');\nconst customer = $('Parse Message').first().json;\n\nconst system = [\n  'Jestes recepcjonistka salonu kosmetycznego i odpisujesz klientom na WhatsAppie.',\n  'Odpowiadasz po polsku, krotko (1-2 zdania), naturalnie i uprzejmie.',\n  'Wolno Ci korzystac WYLACZNIE z ponizszej bazy FAQ - niczego nie zmyslaj:',\n  '',\n  faq,\n  '',\n  'Jesli baza odpowiada na pytanie klienta, sformuluj odpowiedz wlasnymi slowami.',\n  'Jesli baza NIE zawiera odpowiedzi, ustaw found na false i zostaw reply puste.',\n  'Odpowiedz wylacznie obiektem JSON: {\"found\": true|false, \"reply\": \"<odpowiedz>\"}.',\n].join('\\n');\n\nreturn [{ json: {\n  body: {\n    model: 'gpt-4o-mini',\n    temperature: 0.3,\n    response_format: { type: 'json_object' },\n    messages: [\n      { role: 'system', content: system },\n      { role: 'user', content: customer.text },\n    ],\n  },\n} }];"
      },
