    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Weryfikacja podpisu X-Hub-Signature-256 od Mety.\n// Wymaga: NODE_FUNCTION_ALLOW_BUILTIN=crypto w środowisku n8n oraz opcji \"Raw Body\" na webhooku.\nconst crypto = require('crypto');\n\nconst appSecret = $env.WHATSAPP_APP_SECRET;\nif (!appSecret) {\n  throw new Error('Brak WHATSAPP_APP_SECRET w zmiennych srodowiskowych n8n');\n}\n\nconst signatureHeader = $json.headers['x-hub-signature-256'];\nif (!signatureHeader) {\n  throw new Error('Brak naglowka X-Hub-Signature-256 - zadanie odrzucone');\n}\n\nconst rawBody = Buffer.from($input.item.binary.data.data, 'base64');\nconst expected = 'sha256=' + crypto.createHmac('sha256', appSecret).update(rawBody).digest('hex');\n\nconst a = Buffer.from(signatureHeader);\nconst b = Buffer.from(expected);\nif (a.length !== b.length || !crypto.timingSafeEqual(a, b)) {\n  throw new Error('Niepoprawny podpis webhooka - zadanie odrzucone');\n}\n\nreturn { json: JSON.parse(rawBody.toString('utf8')) };"
      },
      "id": "code-verify-signature",
      "name": "Verify Signature",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// Wyciaga nadawce i tresc z payloadu WhatsApp Cloud API.\n// Statusy doreczen (sent/delivered/read) i wiadomosci nietekstowe koncza wykonanie bez odpowiedzi.\nconst out = [];\nfor (const item of $input.all()) {\n  const value = item.json.entry?.[0]?.changes?.[0]?.value;\n  const msg = value?.messages?.[0];\n  if (!msg || msg.type !== 'text') continue;\n  out.push({ json: {\n    from: msg.from,\n    text: msg.text.body,\n    name: value.contacts?.[0]?.profile?.name || '',\n    messageId: msg.id,\n  } });\n}\nreturn out;"
      },
