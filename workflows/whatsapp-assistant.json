      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Zasada bezpieczna: przy niskiej pewnosci lub kategorii \"inne\" eskalujemy do czlowieka.\nconst src = $('Parse Message').first().json;\nconst MIN_CONFIDENCE = 0.7;\n\nlet intent = 'eskalacja';\nlet confidence = 0;\ntry {\n  const parsed = JSON.parse($json.choices[0].message.content);\n  intent = parsed.intent;\n  confidence = Number(parsed.confidence) || 0;\n} catch (e) {\n  // model zwrocil niepoprawny JSON -> eskalacja\n}\n\nconst routable = ['faq', 'rezerwacja'];\nif (!routable.includes(intent) || confidence < MIN_CONFIDENCE) {\n  intent = 'eskalacja';\n}\n\nreturn { json: { ...src, intent, confidence } };"
      },
