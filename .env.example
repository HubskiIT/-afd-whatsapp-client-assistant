# WhatsApp Cloud API (Meta for Developers -> Twoja aplikacja -> WhatsApp -> API Setup)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Dowolny wymyslony ciag znakow - ten sam wpisujesz w panelu Meta przy konfiguracji webhooka
WHATSAPP_VERIFY_TOKEN=
# App Settings -> Basic -> App Secret. Sluzy do weryfikacji podpisu X-Hub-Signature-256
WHATSAPP_APP_SECRET=

# OpenAI - klucz wpisujesz jako credential w n8n (typ: OpenAI), nie przez env
OPENAI_API_KEY=

# Google Sheets: ID arkuszy z paska adresu (miedzy /d/ a /edit)
# FAQ_SHEET_ID: arkusz z zakladka "FAQ" (kolumny: question, answer)
FAQ_SHEET_ID=
# LOG_SHEET_ID: arkusz z zakladka "Log" (kolumny: timestamp, customer_phone, message, intent, handled_by, response)
LOG_SHEET_ID=

# Google Calendar: adres kalendarza salonu (np. salon@gmail.com) albo jego ID
GOOGLE_CALENDAR_ID=

# Adres, na ktory ida powiadomienia o eskalacji. W demo wpisz wlasny
ESCALATION_NOTIFY_EMAIL=

# Wymagane w srodowisku n8n - Code node uzywa require('crypto') do weryfikacji podpisu
NODE_FUNCTION_ALLOW_BUILTIN=crypto
